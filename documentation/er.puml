@startchen data_base_diagram
left to right direction

entity "Study Period" as StudyPeriod {
    study_period_id : SERIAL <<key>>
    study_year : INTEGER
    study_period : INTEGER
}

entity "Meeting" as Meeting {
    meeting_id : SERIAL <<key>>
    meeting_date : DATE
    study_period_id : INTEGER <<FK>>
    deadline : TIMESTAMP
}

entity "Document Owner" as DocOwner {
    gamma_owner_id : TEXT <<key>>
}

entity "Member" as Member {
    gamma_user_id : TEXT <<key, FK>>
}

entity "Committee" as Committee {
    gamma_group_id : TEXT <<key, FK>>
}

entity "Document" as Doc {
    document_id : SERIAL <<key>>
    document_name : TEXT
    gamma_owner_id : TEXT <<FK>>
    file_path : TEXT <<unique>>
    uploaded : TIMESTAMP
}

entity "Meeting Document" as MeetingDoc {
    document_id : INTEGER <<key, FK>>
    type_id : INTEGER <<FK>>
    meeting_id : INTEGER <<FK>>
}

entity "Meeting Document Type" as MeetingDocType {
    type_id : SERIAL <<key>>
    type_name : TEXT <<unique>>
}

entity "Division Document" as DivisionDoc {
    document_id : INTEGER <<key, FK>>
    type_id : INTEGER <<FK>>
    study_period_id : INTEGER <<FK>>
}

entity "Division Document Type" as DivisionDocType {
    type_id : SERIAL <<key>>
    type_name : TEXT <<unique>>
}

entity "Liberation Document" as LiberationDoc {
    document_id : INTEGER <<key, FK>>
    type_id : INTEGER <<FK>>
}

entity "Liberation Document Type" as LiberationDocType {
    type_id : SERIAL <<key>>
    type_name : TEXT <<unique>>
}

entity "Document Requirement" as DocRequire {
    document_type_id : INTEGER <<key, FK>>
    meeting_id : INTEGER <<key, FK>>
    gamma_owner_id : TEXT <<key, FK>>
}

entity "Liberation Requirement" as LiberationRequire {
    gamma_owner_id : TEXT <<FK>>
    group_name : TEXT <<key>>
    group_pretty_name : TEXT
    document_type_id : INTEGER <<key, FK>>
}

entity "Sent Mail" as SentMail {
    sent_mail_id : SERIAL <<key>>
    mail_type : TEXT
    meeting_id : INTEGER <<FK>>
    gamma_owner_id : TEXT <<FK>>
    sent_at : TIMESTAMP
}

relationship "Has" as StudyPeriodHasMeeting {
}

StudyPeriod -1- StudyPeriodHasMeeting
StudyPeriodHasMeeting =N= Meeting

relationship "Owns" as OwnerOwnsDocument {
}

DocOwner -1- OwnerOwnsDocument
OwnerOwnsDocument =N= Doc

DocOwner =>= d {Member, Committee}

relationship "Classifies" as MeetingDocumentClassification {
}

Doc =1= MeetingDocumentClassification
MeetingDocumentClassification -1- MeetingDoc

relationship "Is of type" as MeetingDocumentTypeClassification {
}

MeetingDocType -1- MeetingDocumentTypeClassification
MeetingDocumentTypeClassification =N= MeetingDoc

relationship "Belongs to" as MeetingHasDocument {
}

Meeting -1- MeetingHasDocument
MeetingHasDocument =N= MeetingDoc

relationship "Classifies" as DivisionDocumentClassification {
}

Doc =1= DivisionDocumentClassification
DivisionDocumentClassification -1- DivisionDoc

relationship "Is of type" as DivisionDocumentTypeClassification {
}

DivisionDocType -1- DivisionDocumentTypeClassification
DivisionDocumentTypeClassification =N= DivisionDoc

relationship "Belongs to" as StudyPeriodHasDivisionDocument {
}

StudyPeriod -1- StudyPeriodHasDivisionDocument
StudyPeriodHasDivisionDocument =N= DivisionDoc

relationship "Classifies" as LiberationDocumentClassification {
}

Doc =1= LiberationDocumentClassification
LiberationDocumentClassification -1- LiberationDoc

relationship "Is of type" as LiberationDocumentTypeClassification {
}

LiberationDocType -1- LiberationDocumentTypeClassification
LiberationDocumentTypeClassification =N= LiberationDoc

relationship "Requires" as MeetingDocumentRequirement {
}

DivisionDocType -1- MeetingDocumentRequirement
MeetingDocumentRequirement =N= DocRequire

Meeting -1- MeetingDocumentRequirement
MeetingDocumentRequirement =N= DocRequire

DocOwner -1- MeetingDocumentRequirement
MeetingDocumentRequirement =N= DocRequire

relationship "Requires" as LiberationDocumentRequirement {
}

LiberationDocType -1- LiberationDocumentRequirement
LiberationDocumentRequirement =N= LiberationRequire

DocOwner -1- LiberationDocumentRequirement
LiberationDocumentRequirement =N= LiberationRequire

relationship "Records" as MeetingMail {
}

Meeting -1- MeetingMail
MeetingMail =N= SentMail

relationship "Receives" as OwnerMail {
}

DocOwner -1- OwnerMail
OwnerMail =N= SentMail

@endchen
